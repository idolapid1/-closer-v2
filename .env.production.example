# Production server-only configuration. Supply through the deployment secret manager.
NODE_ENV=production
DATABASE_URL=postgresql://postgres.PROJECT:password@HOST:6543/postgres?sslmode=require
AUTH_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
FRONTEND_ORIGIN=https://app.example.com
HOST=0.0.0.0
PORT=8787
CONNECTOR_EXECUTION_MODE=mock
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_MS=30000
ALLOW_DEVELOPMENT_INVITE_LINKS=false
REQUEST_RATE_LIMIT=240
WEBHOOK_RATE_LIMIT=600

# Browser build-time public configuration. Never place service-role keys here.
VITE_CLOSER_DATA_MODE=PRODUCTION
VITE_CLOSER_API_URL=https://api.example.com
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
