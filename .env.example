# Server-only local production-foundation configuration. Never prefix secrets with VITE_.
DATABASE_URL=postgres://closer:closer_local_only@127.0.0.1:54329/closer
AUTH_JWKS_URL=https://your-auth-project.example/.well-known/jwks.json
AUTH_ISSUER=https://your-auth-project.example
AUTH_AUDIENCE=closer-api
CONNECTOR_EXECUTION_MODE=mock
PORT=8787

