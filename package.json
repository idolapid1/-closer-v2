{
  "name": "closer-v2",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "start:server": "node --env-file=.env dist-server/server/index.js",
    "db:migrate": "tsx --env-file=.env server/migrate.ts",
    "build": "vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run test:client && npm run test:server",
    "test:client": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run",
    "test:watch": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs",
    "test:server": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run --config vitest.server.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "gsap": "^3.15.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.31.0",
    "ogl": "^1.0.11",
    "pg": "^8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/pg": "^8.15.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
