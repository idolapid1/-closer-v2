# Local Fastify/Postgres process configuration. Copy to .env and replace placeholders.
NODE_ENV=development
DATABASE_URL=postgres://closer:closer_local_only@127.0.0.1:54329/closer
AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://your-project.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
FRONTEND_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8787
CONNECTOR_EXECUTION_MODE=mock
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_MS=30000
ALLOW_DEVELOPMENT_INVITE_LINKS=true
DEVELOPMENT_INVITE_BASE_URL=http://127.0.0.1:5173/accept-invite
REQUEST_RATE_LIMIT=240
WEBHOOK_RATE_LIMIT=600

# Browser values are public configuration, never server secrets.
VITE_CLOSER_DATA_MODE=PRODUCTION
VITE_CLOSER_API_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
